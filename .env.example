# ============================================================
# KRISHI INTELLIGENCE — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
# SQLite (default for prototype) — no change needed
DATABASE_URL=sqlite:///./krishi.db

# For production: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/krishi

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Weather API -----
# Open-Meteo is FREE — no key required
# These coordinates are for Lucknow, UP (default demo location)
DEFAULT_LATITUDE=26.8467
DEFAULT_LONGITUDE=80.9462
DEFAULT_LOCATION=Lucknow

# ----- Market Data API (optional) -----
# Register at https://data.gov.in to get a free API key
# Without this key, the system uses historical seed data (clearly labelled)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# ----- AI Explanations (optional) -----
# Without this key, the system uses rule-based explanations (still fully functional)
# Get a free key at https://makersuite.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ----- ML Model -----
ML_MODEL_DIR=./ml/models
PRICE_PREDICTION_MIN_OBSERVATIONS=52

# ----- Storage / Transport defaults -----
# Default storage cost per quintal per day (₹)
STORAGE_COST_PER_QTL_PER_DAY=5.0

# ----- Soil Health Card Uploads -----
# Upload directory path is isolated under data/uploads/soil/<farm_id>/
# Maximum file size limit: 10 MB (10485760 bytes)
SOIL_UPLOAD_MAX_BYTES=10485760

# ============================================================
# DATA SOURCE PROVENANCE MATRIX (Default Offline / Demo Configuration)
# Open-Meteo Weather: LIVE (REST endpoint, no key required)
# Mandi Prices:       HISTORICAL_SEED (or LIVE if DATA_GOV_IN_API_KEY is configured)
# Soil Profile:       REGIONAL_ESTIMATE (or SOIL_HEALTH_CARD / FARMER_ENTERED upon confirmation)
# Agronomic Advice:   RULE_BASED (or GEMINI-enhanced if GEMINI_API_KEY is configured)
# Decision Engine:    CALCULATED (Deterministic Net Realization Simulation)
# ============================================================
